{
  "name": "sportluiz",
  "version": "1.0.0",
  "private": true,
  "description": "SportLuiz Performance Sports SaaS Monorepo",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "postinstall": "prisma generate --schema=database/schema.prisma",
    "install:all": "npm install && npm install --prefix client && npm install --prefix server",
    "prisma:validate": "prisma validate --schema=database/schema.prisma",
    "prisma:generate": "prisma generate --schema=database/schema.prisma",
    "prisma:push": "prisma db push --schema=database/schema.prisma",
    "db:seed": "node database/seed.js",
    "dev": "npm run dev --prefix server & npm run dev --prefix client"
  },
  "dependencies": {
    "pg": "^8.12.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "prisma": "^5.14.0"
  }
}

